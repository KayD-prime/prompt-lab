# Copy this file to .env and fill in ONE provider. .env is in .gitignore: it never reaches GitHub.

# Groq (free tier, console.groq.com/keys)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_key_here        # until you paste a real key, the practice server answers
MODEL=openai/gpt-oss-20b

# Ollama on your own computer (ollama pull qwen2.5:1.5b first)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=local
# MODEL=qwen2.5:1.5b

# No key at all: the practice server (canned answers, free, offline)
# PROMPTLAB_PRACTICE=1
